{
  "name": "calcbloc-excel",
  "version": "0.1.0",
  "private": true,
  "description": "CalcBloc for Microsoft Excel: custom functions for take-home pay, income tax, employer cost and tax-table rates, plus a task pane that inserts official tax tables with their sources.",
  "license": "MIT",
  "author": "CalcBloc (https://calcbloc.com)",
  "homepage": "https://calcbloc.com/developers?utm_source=calcbloc-excel&utm_medium=package&utm_campaign=itmarkerz-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmarkerz/calcbloc-excel.git"
  },
  "bugs": {
    "url": "https://github.com/itmarkerz/calcbloc-excel/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3104
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "start:web": "office-addin-debugging start manifest.xml web --document",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:prod": "office-addin-manifest validate dist/manifest.xml",
    "certs": "office-addin-dev-certs install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "webpack --mode development --watch"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/office-js": "^1.0.617",
    "@types/office-runtime": "^1.0.40",
    "copy-webpack-plugin": "^14.0.0",
    "custom-functions-metadata-plugin": "^3.0.1",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  }
}
